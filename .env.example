# Jomarkhata frontend — environment variables
#
# Copy to .env.local for local development; set the same names in Vercel → Settings →
# Environment Variables for production. All NEXT_PUBLIC_* values are public (they ship to
# the browser); real secrets live only in the backend's .env.
#
# Login: when the 4 Firebase values AND the API URL are set, real sign-in is on.
# When any is empty, the app says login isn't available and offers guest / test mode.

# Backend (jomarKhata-be) URL, e.g. http://localhost:4000 locally, https://api.your-domain in production
NEXT_PUBLIC_API_URL=

# Firebase console → Project settings → General → Your apps → Web app (</>) → firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Helpline WhatsApp number shown as "সাহায্য দরকার? WhatsApp-এ লিখুন" (public, not a secret).
# Bangladeshi mobile, e.g. 01712345678. Leave empty to hide the button.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# SEO (public, not secrets). Site URL for canonical links, sitemap and share images;
# on Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=
# Developer portfolio, linked from the landing-page footer and search-engine data.
NEXT_PUBLIC_DEVELOPER_URL=

# ImageKit (profile photos, payment QR). Uploads go under /jomarkhata/...
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
